[Unit]
Description=GTOL automatic Wake-on-LAN watchdog
After=network-online.target remote-wake.service
Wants=network-online.target
Requires=remote-wake.service

[Service]
Type=simple
ExecStart=/usr/local/sbin/pc-wake-watchdog
Restart=always
RestartSec=5
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
